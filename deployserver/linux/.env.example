# Chi copy khoi WORD EDITOR nay vao deployserver/linux/.env dang dung.
# Khong thay the hoac commit file .env production.

# Chay thu an toan: bat tab/API nhung file Excel co watermark SHADOW.
# Sau khi HR ky nghiem thu, doi SHADOW_MODE=false va chay lai build-prod.sh.
HR_PRODUCTION_ATTENDANCE_ENABLED=true
HR_PRODUCTION_ATTENDANCE_SHADOW_MODE=false

WORD_EDITOR_ENABLED=false
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.4.0
ONLYOFFICE_PORT=8088
WORD_EDITOR_DOCUMENT_SERVER_URL=https://docs.cfcbooking.io.vn
WORD_EDITOR_BACKEND_URL=https://api.cfcbooking.io.vn
WORD_EDITOR_JWT_SECRET=CHUA_CAU_HINH

# Optional: persistent AES key file for ADMIN web-managed MikroTik credentials.
# Default: $HOME/.local/share/cfcbase/infrastructure/credential.key
# Back up this file together with the database; never commit the key.
# CFC_INFRA_CREDENTIAL_KEY_FILE=/absolute/private/path/credential.key
